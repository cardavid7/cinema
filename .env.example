# Local PostgreSQL (development)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cinema_db

# Neon PostgreSQL (production). In Render this value is set as an
# environment variable in the dashboard; uncomment only to test against Neon.
# Neon connection string (Dashboard -> Connect). Keep ?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

JWT_SECRET_KEY=tu-clave-secreta
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:4200
